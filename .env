# คัดลอกเป็น .env แล้วแก้ค่า
PORT=3000
SITE_NAME=HYP TIP
# อีเมลที่สมัครแล้วจะได้สิทธิ์แอดมิน
ADMIN_EMAIL=purinutchotchuang@gmail.com
# อีเมล Super Admin (เจ้าของเว็บ) คั่นด้วย comma ถ้าหลายคน — ถ้าเว้นว่างจะใช้ค่า ADMIN_EMAIL
SUPER_ADMIN_EMAILS=
# ใช้ตรวจ signature ของ Webhook จาก Payment Gateway (เว้นว่าง = ปิด webhook)
WEBHOOK_SECRET=
# ข้อมูล RDCW Slip Verify (เว้นว่าง = ปิดการตรวจสลิปอัตโนมัติ ค้างรอตรวจด้วยตนเอง)
RDCW_CLIENT_ID=
RDCW_CLIENT_SECRET=
# RDCW_API_URL=https://suba.rdcw.co.th/v2/inquiry
# โฟลเดอร์เก็บฐานข้อมูลและสลิป (บน Render ให้ชี้ไปที่ Persistent Disk เช่น /var/data)
DATA_DIR=./data
